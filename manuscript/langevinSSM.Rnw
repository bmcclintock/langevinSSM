<<include=FALSE>>=
library(knitr)
opts_chunk$set(
concordance=TRUE
)
library(langevinSSM)
examplePar=list(beta=c(-4, 6, 5, -0.1),sigma=5,gamma=0.5)
nbAnimals <- 3
samplingRate <- 2
obsPerAnimal <- 10000*samplingRate
measurementError <- list(smaj.sd=4,smin.sd=1,eor.lim=c(0,180))
set.seed(kind="Mersenne-Twister",normal.kind="Inversion",seed=1)
init <- langevinSSM:::getInitialPosition(nbAnimals,spatialCovs=exampleCovs,beta=examplePar$beta)
initPos<- list()
for(i in 1:nbAnimals){
  initPos[[i]] <- runif(2,850,1150)
}
simDat <- simLangevin(par=examplePar,spatialCovs=exampleCovs,nbAnimals=nbAnimals,initialPosition=initPos,
                          obsPerAnimal=obsPerAnimal,measurementError = measurementError, timeStep=0.01, subSample=list(samplingRate=samplingRate))
start_time <- as.POSIXct(paste(Sys.Date(), "00:00:00"), tz = "UTC")
simDat$date <- start_time + (simDat$date * 3600*24)
simDat$lc <- NA_character_
simDat$mu.x <- simDat$mu.y <- simDat$vel.x <- simDat$vel.y <- NULL
rawData <- simDat[,c("id","date","x","y","smaj","smin","eor")]
rawData$eor <- rawData$eor * 180 / pi
class(rawData) <- "data.frame"
attr(rawData,"time.unit") <- NULL

library(ggplot2)
library(patchwork)

# 1. Calculate the true UD
# Using the beta values from examplePar in simData.R
UD <- getUD(spatialCovs = exampleCovs, beta = c(-4, 6, 5, -0.1), plot = FALSE)

# 2. Define the track layers and reorder them so Track 1 is drawn on top
dat_plot <- simDat
# Reversing the factor levels forces ggplot to draw 3 first, then 2, then 1
dat_plot$id <- factor(dat_plot$id, levels = c("3", "2", "1"))

track_layers <- list(
  geom_path(data = dat_plot, aes(x = x, y = y, color = id, group = id),
            linewidth = 0.3, alpha = 0.7, na.rm = TRUE),

  geom_point(data = dat_plot, aes(x = x, y = y, color = id),
             size = 0.2, alpha = 0.7, na.rm = TRUE),

  scale_color_manual(
    name = "Track ID",
    values = c("1" = "#D55E00", "2" = "#CC79A7", "3" = "#E69F00"),
    breaks = c("1", "2", "3"), # Keeps the legend ordered 1, 2, 3
    guide = guide_legend(override.aes = list(alpha = 1, size = 2, linewidth = 1.5))
  )
)

# 3. Top Left: Track-only plot
ext_vec <- as.vector(terra::ext(exampleCovs[[1]]))
p_tracks <- ggplot() +
  track_layers +
  coord_equal(xlim = c(ext_vec["xmin"], ext_vec["xmax"]), ylim = c(ext_vec["ymin"], ext_vec["ymax"])) +
  theme_minimal() +
  labs(x = "easting", y = "northing")

# 4. Top Right: True UD plot
p_ud <- plotRaster(UD, legend.title = "log(UD)") +
  labs(x = "easting", y = "northing")

# 5. Bottom four plots: Covariates only (no tracks)
p1 <- plotRaster(exampleCovs[[1]]) + labs(x = "easting", y = "northing")
p2 <- plotRaster(exampleCovs[[2]]) + labs(x = "easting", y = "northing")
p3 <- plotRaster(exampleCovs[[3]]) + labs(x = "easting", y = "northing")
p4 <- plotRaster(exampleCovs[[4]], legend.title = "d2c") + labs(x = "easting", y = "northing")

# 6. Strip inner axes for a clean layout
no_x <- theme(axis.title.x = element_blank(), axis.text.x = element_blank(), axis.ticks.x = element_blank())
no_y <- theme(axis.title.y = element_blank(), axis.text.y = element_blank(), axis.ticks.y = element_blank())

p_tracks <- p_tracks + no_x           # Row 1, Col 1
p_ud     <- p_ud + no_x + no_y        # Row 1, Col 2
p1       <- p1 + no_x                 # Row 2, Col 1
p2       <- p2 + no_x + no_y          # Row 2, Col 2
p3       <- p3                        # Row 3, Col 1
p4       <- p4 + no_y                 # Row 3, Col 2

# 7. Assemble the 3x2 grid using pure patchwork
covs_plot <- p_tracks + p_ud + p1 + p2 + p3 + p4 + plot_layout(ncol = 2)

# 8. Save to PDF
pdf("covPlot.pdf", width = 8, height = 11)
print(covs_plot)
dev.off()
@

