CXX_STD = CXX17

# Enables large object compilation for Windows
CXX17FLAGS += -Wa,-mbig-obj

# Flags shared by the Rcpp sources and the TMB library (src/TMB, built by TMB/compile.R)
LSSM_FLAGS = -DNDEBUG -DEIGEN_NO_DEBUG

# OpenMP (optional): $(SHLIB_OPENMP_CXXFLAGS) is empty where R was built without OpenMP support
# (e.g. the Apple clang toolchain), in which case everything compiles and runs serially.
# Armadillo's own OpenMP use is disabled so that only the explicit 'ncores' argument creates threads.
PKG_CPPFLAGS = -DARMA_DONT_USE_OPENMP
PKG_CXXFLAGS = $(LSSM_FLAGS) $(SHLIB_OPENMP_CXXFLAGS)

# Explicitly link BLAS and LAPACK for RcppArmadillo
PKG_LIBS = $(SHLIB_OPENMP_CXXFLAGS) $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

.PHONY: all compile_tmb clean

all: $(SHLIB)

$(SHLIB): compile_tmb

compile_tmb:
	(cd TMB; "$(R_HOME)/bin/Rscript" --no-save --no-restore compile.R '$(LSSM_FLAGS)' '$(SHLIB_OPENMP_CXXFLAGS)')

clean:
	rm -f $(SHLIB) $(OBJECTS)
	rm -f TMB/*.o TMB/*.so TMB/*.dll
