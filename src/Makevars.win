CXX_STD = CXX17

# Enables large object compilation for Windows
CXX17FLAGS += -Wa,-mbig-obj

# Safe, standard package-wide flags (Vectorization remains FULLY active)
PKG_CXXFLAGS = -DNDEBUG -DEIGEN_NO_DEBUG

# Explicitly link BLAS and LAPACK for RcppArmadillo
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

.PHONY: all compile_tmb clean

all: $(SHLIB)

$(SHLIB): compile_tmb

# --- TARGETED CRAN-COMPLIANT FIX FOR GCC 14 OPTIMIZER BUG ---
# Compiles RcppExports.cpp at -O2 instead of -O3 on Windows.
# This prevents the emmintrin.h false-positive while preserving full Eigen SIMD vectorization.
RcppExports.o: RcppExports.cpp
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -O2 -c $< -o $@

compile_tmb:
	(cd TMB; "$(R_HOME)/bin/Rscript" --no-save --no-restore compile.R '$(PKG_CXXFLAGS)')

clean:
	rm -f $(SHLIB) $(OBJECTS)
	rm -f TMB/*.o TMB/*.so TMB/*.dll
