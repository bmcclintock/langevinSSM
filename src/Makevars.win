CXX_STD = CXX17

# Enables large object compilation
CXX17FLAGS += -Wa,-mbig-obj

# Disable Eigen vectorization on Windows to bypass GCC 14.3 array-bounds false positive
PKG_CXXFLAGS = -DNDEBUG -DEIGEN_NO_DEBUG -Wa,-mbig-obj -DEIGEN_DONT_VECTORIZE
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

.PHONY: all compile_tmb clean

all: $(SHLIB)

$(SHLIB): compile_tmb

compile_tmb:
	(cd TMB; "$(R_HOME)/bin/Rscript" --no-save --no-restore compile.R "$(PKG_CXXFLAGS)")

clean:
	rm -f $(SHLIB) $(OBJECTS)
	rm -f TMB/*.o TMB/*.so TMB/*.dll
