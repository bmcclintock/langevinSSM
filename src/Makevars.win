CXX_STD = CXX17

# Enables large object compilation for Windows and suppresses false-positive array bounds warnings
CXX17FLAGS += -Wa,-mbig-obj -Wno-array-bounds

# GCC 14.3.0 (Rtools45) reports false-positive array-bounds warnings in
# Armadillo's SSE/SIMD matrix operations (emmintrin.h:700).
PKG_CXXFLAGS = -DNDEBUG -DEIGEN_NO_DEBUG -Wno-array-bounds

# Explicitly link BLAS and LAPACK for RcppArmadillo
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

.PHONY: all compile_tmb clean

all: $(SHLIB)

$(SHLIB): compile_tmb

compile_tmb:
	(cd TMB; CXX17FLAGS="$(CXX17FLAGS)" "$(R_HOME)/bin/Rscript" --no-save --no-restore compile.R '$(PKG_CXXFLAGS)')

clean:
	rm -f $(SHLIB) $(OBJECTS)
	rm -f TMB/*.o TMB/*.so TMB/*.dll
