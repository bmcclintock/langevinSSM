CXX_STD = CXX17

# Enables large object compilation for Windows
CXX17FLAGS += -Wa,-mbig-obj

# GCC 14.3.0 (Rtools45) reports false-positive array-bounds warnings in 
# Armadillo's SSE/SIMD matrix operations (emmintrin.h:700). These warnings 
# occur in auto-vectorized code paths for matrix multiplication and element-wise
# operations and are not actual bugs—Armadillo's internal buffers are properly 
# aligned and access patterns are safe.
#
# Warnings appear only on Windows with GCC 14.3.0; Linux/macOS builds pass cleanly.
# See: https://github.com/arma-dev/armadillo-code/issues
#
# This suppression is necessary for CRAN compliance on Windows while maintaining
# strict warning checking elsewhere.
PKG_CXXFLAGS = -DNDEBUG -DEIGEN_NO_DEBUG -Wno-array-bounds

# Explicitly link BLAS and LAPACK for RcppArmadillo
PKG_LIBS = $(LAPACK_LIBS) $(BLAS_LIBS) $(FLIBS)

.PHONY: all compile_tmb clean

all: $(SHLIB)

$(SHLIB): compile_tmb

compile_tmb:
	(cd TMB; "$(R_HOME)/bin/Rscript" --no-save --no-restore compile.R '$(PKG_CXXFLAGS)')

clean:
	rm -f $(SHLIB) $(OBJECTS)
	rm -f TMB/*.o TMB/*.so TMB/*.dll
